          Questão 1 de 5
        </div>
      </div>

      <div id="quiz-container" class="max-w-4xl mx-auto space-y-6">
        
        <!-- Clinical Vignette Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
